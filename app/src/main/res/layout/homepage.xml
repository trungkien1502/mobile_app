<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6682F4F8"
    >

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="356dp"
        android:layout_height="250dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutWelcomeText">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="start"
            >
            <Button
                android:id="@+id/button1"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Đặt khám"

                />

            <Button
                android:id="@+id/button2"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Hồ sơ sức khoẻ" />

            <Button
                android:id="@+id/button3"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="end"
           >
            <Button
                android:id="@+id/button4"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Button" />

            <Button
                android:id="@+id/button5"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Button" />

            <Button
                android:id="@+id/button6"
                android:layout_width="173dp"
                android:layout_height="60dp"
                android:text="Button" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayoutWelcomeText"
        android:layout_width="356dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewHello"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xin chào!"
            android:textSize="22sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textSize="24sp"
            android:textStyle="bold"

            />

        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Chào mừng đến với UIT HealthCare"
            android:textSize="22sp"

            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        app:elevation="5dp"
        app:itemBackground="@drawable/edit_text_bg"
        app:itemIconSize="35dp"
        app:itemIconTint="@color/black"
        app:itemTextAppearanceActive="@style/Bottom_bar"
        app:itemTextAppearanceInactive="@style/Bottom_bar"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_bar"
        app:itemTitleSize="10dp"


        />


</androidx.constraintlayout.widget.ConstraintLayout>